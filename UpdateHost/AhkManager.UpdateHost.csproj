<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <AssemblyName>AhkManager.UpdateHost</AssemblyName>
        <RootNamespace>Bezoro.AhkManager.UpdateHost</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
    <ItemGroup>
        <Compile
            Include="../Core/Infrastructure/WindowsStoragePath.cs"
            Link="Interop/WindowsStoragePath.cs"
        />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>
</Project>
