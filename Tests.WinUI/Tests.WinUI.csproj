<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
  <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion><SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier><Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget>
  <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><EnableMsixTooling>false</EnableMsixTooling>
  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants><DefaultLanguage>pt-BR</DefaultLanguage>
  <AssemblyName>Bezoro.AhkManager.WinUI.Tests</AssemblyName><RootNamespace>Bezoro.AhkManager.WinUI.Tests</RootNamespace>
  <!-- Both executable projects require their default native SDK initialization.
       InternalsVisibleTo exposes the SDK's same-named internal helper types; retain
       those two generated CS0436 warnings without promoting them to errors. -->
  <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0436</WarningsNotAsErrors>
 </PropertyGroup>
 <ItemGroup><ApplicationDefinition Include="TestHost.xaml"/><Page Remove="TestHost.xaml"/><ProjectReference Include="../Presentation.WinUI/Bezoro.AhkManager.WinUI.csproj"/><PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.26100.9169]" PrivateAssets="all"/></ItemGroup>
 <Target Name="PublishNativeXamlResources" AfterTargets="Publish">
  <ItemGroup><NativeXamlPublishResource Include="$(TargetDir)*.pri;$(TargetDir)**\*.xbf"/></ItemGroup>
  <Copy SourceFiles="@(NativeXamlPublishResource)" DestinationFiles="@(NativeXamlPublishResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
 </Target>
</Project>
