<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <AssemblyName>ahk-manager</AssemblyName>
        <RootNamespace>Bezoro.AhkManager.AgentCli</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Core/AhkManager.Core.csproj" />
        <EmbeddedResource
            Include="../Presentation.Electron/src/shared/agent-commands.json"
            LogicalName="Bezoro.AhkManager.AgentCli.CommandCatalog.json"
        />
    </ItemGroup>
</Project>
