<Window x:Class="Bezoro.AhkManager.WinUI.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Bezoro.AhkManager.WinUI.ViewModels">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="RootGrid" Loaded="RootLoaded" SizeChanged="RootSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TitleBar x:Name="NativeTitleBar" x:Uid="ShellTitleBar" />
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="NavigationChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Uid="ScriptsNav" Tag="scripts" Icon="Document" IsSelected="True"/>
    <NavigationViewItem x:Uid="HotkeysNav" Tag="hotkeys" Icon="Keyboard"/>
    <NavigationViewItem x:Uid="ActivityNav" Tag="activity" Icon="Clock"/>
    <NavigationViewItemSeparator/>
    <NavigationViewItemHeader x:Uid="CollectionsNav"/>
    <NavigationViewItem x:Uid="AllCollectionsNav" Tag="all" Icon="Library"/>
    <NavigationViewItem x:Uid="ManageCollectionsNav" Tag="collections" Icon="Folder"/>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems><NavigationViewItem x:Uid="HelpNav" Tag="help" Icon="Help"/></NavigationView.FooterMenuItems>
   <Grid Padding="24,16,24,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <InfoBar x:Name="GlobalInfo" IsOpen="False" Severity="Informational" IsClosable="True" Margin="0,0,0,12"><InfoBar.ActionButton><Button x:Uid="GlobalRecovery" Click="GlobalRecoveryClicked"/></InfoBar.ActionButton></InfoBar>
    <Grid x:Name="ScriptsPage" Grid.Row="1" Grid.RowSpan="2" RowSpacing="16" ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="310"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="4"><TextBlock x:Uid="ScriptsHeading" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="CounterSubtitle" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="RefreshAction" x:Uid="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}"><SymbolIcon Symbol="Refresh"/></Button><Button x:Name="AddAction" x:Uid="AddButton" Style="{StaticResource AccentButtonStyle}"><Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock x:Uid="AddButtonLabel"/></StackPanel></Button.Content><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Uid="AddFiles" Click="AddFilesClicked"/><MenuFlyoutItem x:Uid="AddFolder" Click="AddFolderClicked"/></MenuFlyout></Button.Flyout></Button></StackPanel>
     </Grid>
     <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="SearchBox" x:Uid="SearchBox" TextChanged="SearchChanged" QueryIcon="Find"/>
      <ComboBox x:Name="StatusBox" x:Uid="StatusBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="QueryChanged" HorizontalAlignment="Stretch"><ComboBoxItem x:Uid="FilterAll"/><ComboBoxItem x:Uid="FilterRunning"/><ComboBoxItem x:Uid="FilterStopped"/><ComboBoxItem x:Uid="FilterProblems"/></ComboBox>
      <ComboBox x:Name="SortBox" x:Uid="SortBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="QueryChanged" HorizontalAlignment="Stretch"><ComboBoxItem x:Uid="SortName"/><ComboBoxItem x:Uid="SortStatus"/><ComboBoxItem x:Uid="SortCollection"/></ComboBox>
     </Grid>
     <Grid Grid.Row="2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Padding="16,0,16,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition x:Name="HotkeyHeaderColumn" Width="105"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock x:Uid="NameColumn" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock x:Uid="StatusColumn" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock x:Name="HotkeyHeader" x:Uid="HotkeyColumn" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock x:Uid="LoginColumn" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"/></Grid>
      <ListView x:Name="ScriptList" x:Uid="ScriptList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single" SelectionChanged="ScriptSelectionChanged" HorizontalContentAlignment="Stretch">
       <ListView.ItemTemplate><DataTemplate x:DataType="vm:ScriptRow">
        <Grid Padding="4,10" ColumnSpacing="12" MinHeight="64"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition x:Name="RowHotkeyColumn" Width="105"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
         <VisualStateManager.VisualStateGroups><VisualStateGroup>
          <VisualState x:Name="WideRow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="RowHotkeyColumn.Width" Value="105"/><Setter Target="RowHotkey.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CompactRow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="RowHotkeyColumn.Width" Value="0"/><Setter Target="RowHotkey.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState>
         </VisualStateGroup></VisualStateManager.VisualStateGroups>
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><SymbolIcon Symbol="Document" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name,Mode=OneWay}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name,Mode=OneWay}"/><TextBlock Text="{x:Bind FileName,Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName,Mode=OneWay}"/></StackPanel></Grid>
         <TextBlock Grid.Column="1" Text="{x:Bind Status,Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
         <Border x:Name="RowHotkey" Grid.Column="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{x:Bind MainHotkey,Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind MainHotkey,Mode=OneWay}"/></Border>
         <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Startup,Mode=OneWay}" IsEnabled="{x:Bind CanEdit,Mode=OneWay}" Toggled="StartupToggled" Tag="{x:Bind Id}" OnContent="{x:Bind StartupOn}" OffContent="{x:Bind StartupOff}" AutomationProperties.Name="{x:Bind StartupLabel}" VerticalAlignment="Center"/>
        </Grid>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="330"><SymbolIcon Symbol="Document"/><TextBlock x:Uid="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"/><TextBlock x:Uid="EmptyBody" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
     </Grid>
     <Border x:Name="Inspector" Grid.Column="1" Grid.RowSpan="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
      <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14">
       <TextBlock x:Name="SelectedTitle" x:Uid="InspectorTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
       <TextBlock x:Name="SelectedState" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="StartAction" x:Uid="StartAction" Tag="Start" Click="OperationClicked" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="StopAction" x:Uid="StopAction" Tag="Stop" Click="OperationClicked"/><Button x:Name="RestartAction" x:Uid="RestartAction" Tag="Restart" Click="OperationClicked"/></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="PauseAction" x:Uid="PauseAction" Tag="TogglePause" Click="OperationClicked"/><Button x:Name="SuspendAction" x:Uid="SuspendAction" Tag="ToggleSuspend" Click="OperationClicked"/></StackPanel>
       <TextBlock x:Name="CapabilityNote" x:Uid="CapabilityNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
       <TextBlock x:Name="SelectedIssues" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
       <TextBlock x:Uid="FileSection" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,8,0,0"/>
       <TextBlock x:Name="SelectedPath" IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="EditAction" x:Uid="EditAction" Tag="Edit" Click="OperationClicked"/><Button x:Name="FolderAction" x:Uid="FolderAction" Tag="OpenFolder" Click="OperationClicked"/></StackPanel>
       <TextBlock x:Name="ExecutionHeading" x:Uid="ExecutionSection" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,8,0,0"/>
       <TextBlock x:Name="SelectedProcess" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
       <TextBlock x:Uid="HotkeysSection" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,8,0,0"/>
       <TextBlock x:Name="SelectedHotkeys" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
       <TextBlock x:Uid="ActivitySection" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,8,0,0"/>
       <TextBlock x:Name="SelectedActivity" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
       <Expander x:Name="MetadataExpander" x:Uid="MetadataExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="14">
        <TextBox x:Name="NameDraft" x:Uid="NameDraft" TextChanged="DraftChanged"/>
        <TextBox x:Name="DescriptionDraft" x:Uid="DescriptionDraft" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" TextChanged="DraftChanged"/>
        <ComboBox x:Name="CollectionDraft" x:Uid="CollectionDraft" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="DraftCollectionChanged"/>
        <TextBox x:Name="HotkeysDraft" x:Uid="HotkeysDraft" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" TextChanged="DraftChanged"/>
        <CheckBox x:Name="AdminDraft" x:Uid="AdminDraft" Checked="DraftChecked" Unchecked="DraftChecked"/>
        <CheckBox x:Name="BlockedDraft" x:Uid="BlockedDraft" Checked="DraftChecked" Unchecked="DraftChecked"/>
        <Button x:Name="SaveDraftAction" x:Uid="SaveDraftAction" Click="SaveDraftClicked"/>
        <Button x:Name="RemoveAction" x:Uid="RemoveAction" Click="RemoveClicked"/>
       </StackPanel></Expander>
       <Button x:Name="RecoverAction" x:Uid="RecoverAction" Tag="Recover" Click="OperationClicked"/>
      </StackPanel></ScrollViewer>
     </Border>
     <Expander x:Name="CompactInspector" x:Uid="CompactInspector" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
    </Grid>
    <Grid x:Name="OtherPage" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="OtherTitle" Style="{StaticResource TitleTextBlockStyle}"/>
     <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OtherFilter" x:Uid="OtherFilter" TextChanged="OtherFilterChanged"/><Button x:Name="OtherAction" Grid.Column="1" Click="OtherActionClicked"/></Grid>
     <ListView x:Name="OtherList" Grid.Row="2" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="vm:DetailRow"><StackPanel Padding="8,12" Spacing="4"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
   </Grid>
  </NavigationView>
  <Grid Grid.Row="2" Padding="20,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" Style="{StaticResource CaptionTextBlockStyle}"/><ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind ViewModel.Busy,Mode=OneWay}"/></Grid>
 </Grid>
</Window>
